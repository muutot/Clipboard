{
  "name": "clipboard-desktop",
  "version": "1.5.0",
  "description": "A high-performance cross-platform clipboard manager built with Tauri and Rust.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "format": "npm run format:prettier && npm run format:rust",
    "format:check": "npm run format:prettier:check && npm run format:rust:check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test -j 1 --manifest-path src-tauri/Cargo.toml --workspace",
    "lint:rust": "cargo clippy -j 1 --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "verify": "npm run format:check && npm run check && npm run build && npm run test:rust && npm run lint:rust",
    "ci:local": "powershell -ExecutionPolicy Bypass -File scripts/local-ci.ps1",
    "tauri": "tauri"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
