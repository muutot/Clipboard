{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard",
  "version": "0.1.0",
  "identifier": "com.clipboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipboard",
        "width": 720,
        "height": 700,
        "minWidth": 750,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
